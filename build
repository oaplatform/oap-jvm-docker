#! /bin/bash
set -e
set -x

DOCKER_REPOSITORY=${1:?Parameter missing: Docker repository.}
DOCKER_PROJECT_NAME=${2:?Parameter missing: Docker project name.}
DOCKER_VERSION=${3:?Parameter missing: Version.}
MONGO=${4:-false}

docker buildx build \
    --push \
    --build-arg mongo=$MONGO \
    --platform linux/amd64,linux/arm64/v8 \
    -t "${DOCKER_REPOSITORY}/${DOCKER_PROJECT_NAME}:${DOCKER_VERSION}" \
    -f Dockerfile .
